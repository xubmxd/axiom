PORT=3100
APP_URL=http://localhost:3100
COURSES_ROOT=./courses
DATA_DIR=./data
# DATABASE_URL=postgres://lumen:lumen@db:5432/lumen
SESSION_SECRET=change-me-to-32-random-bytes
COOKIE_SECURE=0
SESSION_DAYS=30
VIDEO_COMPLETION_THRESHOLD=0.9
READING_COMPLETION_THRESHOLD=0.9
READING_INACTIVITY_TIMEOUT=60
LEARNING_SESSION_HEARTBEAT=15
STREAK_MINUTES=15
# ---- Cyber Range ----
# docker: isolated bridge network + container per lab (needs /var/run/docker.sock)
# local:  in-process loopback target, same WHOIS behavior (dev/CI fallback)
# auto:   docker when the daemon is reachable, otherwise local
LAB_PROVIDER=auto
# AXIOM_SELF_CONTAINER=axiom-app  # set when Axiom runs in compose (lets the app join lab nets)
# LAB_DOCKER_SUBNET_BASE=10.210
# LAB_LOCAL_SUBNET_BASE=10.200
# ---- Student VPN (optional WireGuard gateway so personal Kali VMs reach lab targets) ----
# VPN_ENABLED=1
# VPN_ENDPOINT_HOST=192.168.1.10  # LAN/public IP or hostname students connect to (UDP port below)
# VPN_ENDPOINT_PORT=51820
# VPN_SUBNET_BASE=10.212          # /24 for student tunnel IPs; keep clear of 10.200/10.210
# VPN_GATEWAY_CONTAINER=axiom-vpn
