# dependencies
node_modules/

# runtime / secrets — never commit
.env
data/

# course MEDIA lives on disk, not in git (synced separately with rsync).
# Directory structure is preserved via .gitkeep files.
courses/*
!courses/video/
!courses/reading/
courses/video/*
!courses/video/.gitkeep
courses/reading/*
!courses/reading/.gitkeep

# Lab content (definitions + target images) stays local — never push.
# It contains answer hashes and challenge data for private practice.
/labs/
/lab-images/

# supplied exercise source material — never commit
Labs.pdf
*Exercise*.pdf

# OS / editor noise
.DS_Store
Thumbs.db
